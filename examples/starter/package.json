{
  "name": "@tsuki-hono/starter",
  "version": "0.0.8",
  "private": true,
  "description": "Reference starter for building applications with Tsuki",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "nodemon",
    "start": "node dist/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tsuki-hono/common": "workspace:*",
    "@tsuki-hono/core": "workspace:*",
    "@tsuki-hono/event-emitter": "workspace:*",
    "@tsuki-hono/openapi": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "picocolors": "1.1.1",
    "reflect-metadata": "0.2.2",
    "tsyringe": "4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "3.1.14",
    "typescript": "^6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
