{
  "name": "tsuki",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "pnpm --filter @tsuki-hono/benchmarks bench",
    "build": "pnpm -r run build",
    "changelog": "changelogithub",
    "format": "prettier --write .",
    "lint": "oxlint . --fix",
    "prepare": "simple-git-hooks",
    "publish:npm": "pnpm -r publish --access public --no-git-checks",
    "release": "bumpp -r --all",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r exec tsrs --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@lobehub/oxlint-config": "^3.0.1",
    "@lobehub/prettier-config": "^3.0.1",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta"
  },
  "packageManager": "pnpm@12.18.0"
}
